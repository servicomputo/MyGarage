// Prisma schema - App de Control y Mantenimiento de Vehículos
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String
  image        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  vehicles     Vehicle[]
}

model Vehicle {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  photo         String?
  make          String
  model         String
  year          Int
  version       String?
  color         String?
  plates        String?
  vin           String?
  mileage       Int      @default(0)
  purchaseDate  DateTime?
  purchasePrice Float?
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  maintenances  Maintenance[]
  parts         Part[]
  expenses      Expense[]
  fuelings      Fueling[]
  reminders     Reminder[]
  documents     Document[]
}

// Tipos de mantenimiento (stored as String for SQLite compatibility)
// OIL_CHANGE, GENERAL_SERVICE, TIRES, BRAKES, BATTERY, COOLANT,
// TRANSMISSION, AC, ELECTRICAL, REPAIR, FUEL, VERIFICATION, INSURANCE, TAX, OTHER
model Maintenance {
  id             String    @id @default(cuid())
  vehicleId      String
  vehicle        Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  type           String    @default("OTHER")
  customType     String?
  date           DateTime  @default(now())
  mileage        Int
  description    String?
  partsCost      Float     @default(0)
  laborCost      Float     @default(0)
  totalCost      Float     @default(0)
  workshop       String?
  notes          String?
  photos         String?
  receipt        String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  parts          Part[]
}

// Categorias de refacciones: FILTER, BRAKE, TIRE, BATTERY, ENGINE,
// TRANSMISSION, ELECTRICAL, COOLING, SUSPENSION, EXHAUST, BODY, OTHER
model Part {
  id              String    @id @default(cuid())
  vehicleId       String
  vehicle         Vehicle   @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  maintenanceId   String?
  maintenance     Maintenance? @relation(fields: [maintenanceId], references: [id], onDelete: SetNull)
  name            String
  category        String    @default("OTHER")
  brand           String?
  partNumber      String?
  installDate     DateTime  @default(now())
  installMileage  Int
  cost            Float     @default(0)
  provider        String?
  estimatedLifeKm Int?
  nextChangeKm    Int?
  notes           String?
  photo           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

// Categorias de gastos: MAINTENANCE, PARTS, FUEL, INSURANCE, TAXES,
// VERIFICATION, TIRES, REPAIRS, WASH, OTHER
model Expense {
  id          String    @id @default(cuid())
  vehicleId   String
  vehicle     Vehicle   @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  category    String    @default("OTHER")
  title       String
  amount      Float
  date        DateTime  @default(now())
  notes       String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

// Tipos de combustible: REGULAR, PREMIUM, DIESEL, OTHER
model Fueling {
  id          String    @id @default(cuid())
  vehicleId   String
  vehicle     Vehicle   @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  date        DateTime  @default(now())
  mileage     Int
  liters      Float
  pricePerL   Float
  total       Float
  fuelType    String    @default("REGULAR")
  station     String?
  fullTank    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// Tipos de recordatorios: OIL_CHANGE, FILTERS, BRAKES, TIRES, BATTERY,
// TUNE_UP, TRANSMISSION, COOLANT, VERIFICATION, INSURANCE, TAX, OTHER
model Reminder {
  id            String    @id @default(cuid())
  vehicleId     String
  vehicle       Vehicle   @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  type          String    @default("OTHER")
  customType    String?
  title         String
  intervalKm    Int?
  intervalDays  Int?
  lastDoneKm    Int?
  lastDoneDate  DateTime?
  nextDueKm     Int?
  nextDueDate   DateTime?
  enabled       Boolean   @default(true)
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

// Tipos de documentos: INVOICE, INSURANCE, REGISTRATION, VERIFICATION,
// REPAIR_INVOICE, MANUAL, WARRANTY, OTHER
model Document {
  id          String    @id @default(cuid())
  vehicleId   String
  vehicle     Vehicle   @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  type        String    @default("OTHER")
  title       String
  fileUrl     String
  fileType    String    @default("image")
  notes       String?
  date        DateTime  @default(now())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}
